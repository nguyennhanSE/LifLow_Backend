model Category {
  productCategoryNumber String @id @unique @db.VarChar(50) @map("product_category_number")
  name CategoryType @unique @map("name")
  description String? @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relation
  products Product[]
  @@map("categories")
}

enum RecipeCategory {
  RECIPE
  REVIEWS
  DAILY_LIFE
}
// Recipe
model Recipe {
  id             String   @id @default(uuid())
  title          String   @db.VarChar(255)
  authorId       String?
  authorName     String   @db.VarChar(100) // denormalized for fast listing
  category       RecipeCategory   @map("category") // denormalized category name
  dateOfWriting  DateTime @map("date_of_writing")
  views          Int      @default(0)
  status         String   @default("active") // e.g., active | inactive
  thumbnailUrl   String?  @map("thumbnail_url")
  content        String
  ingredients    String[] @map("ingredients")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  // extension
  isActive       Boolean @default(true) @map("is_active") // 활성화 여부

  // Relations
  author         User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // productRecipes ProductRecipe[]
  @@index([status])
  @@index([authorId])
  @@index([dateOfWriting])
  @@map("recipes")
}

