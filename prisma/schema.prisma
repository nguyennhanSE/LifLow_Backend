// Coupon
enum CouponType {
  PERCENT // 정률 할인 (Discount rate %)
  AMOUNT  // 정액 할인 (Discount amount)
  FREE_SHIPPING // 무료 배송 (Free shipping)
}


enum CouponHistoryStatus {
  ISSUED     // 발급됨
  USED       // 사용됨
  EXPIRED    // 만료됨
  CANCELLED  // 취소됨
}

model Coupon {
  id String @id @default(uuid())

  name String @db.VarChar(255) @map("name") // 쿠폰명
  code String @unique @db.VarChar(100) @map("code") // 쿠폰코드

  type CouponType @map("type") // 쿠폰 타입'

  // 할인 정보 (type에 따라 하나만 사용)
  discountRate Int? @map("discount_rate") // 할인율(%) - 정률
  discountAmount Int? @map("discount_amount") // 할인금액(KRW) - 정액

  minPurchaseAmount Int @default(0) @map("min_purchase_amount") // 최소 구매 금액(KRW)
  maxDiscountAmount Int? @map("max_discount_amount") // 최대 할인 금액(KRW) - 정률일 때 주로 사용

  imageUrl String? @map("image_url") // 쿠폰 이미지 URL (optional)

  isPermanent Boolean @default(false) @map("is_permanent") // 영구 쿠폰 여부

  isActive Boolean @default(true) @map("is_active") // 활성화 여부

  // 자동 발급 설정 (등급별, 매월 특정일)
  isAutoIssue Boolean @default(false) @map("is_auto_issue") // 자동 발급 여부
  autoIssueDayOfMonth DateTime?  @map("auto_issue_day_of_month") // 매월 n일 (default: 1)

  targetGrades String[] @default([]) @map("target_grades") // 발급 대상 등급 (VIP, VVIP)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  histories CouponHistory[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

// CouponHistory
model CouponHistory {
  id String @id @default(uuid())

  couponId String? @map("coupon_id")
  userId String @map("user_id")
  quantity Int @default(1) @map("quantity") // 발급 수량

  // Optional link to an order when used
  orderId String? @map("order_id")

  status CouponHistoryStatus @default(ISSUED) @map("status") // 상태

  startDate DateTime? @map("start_date") // 시작일
  endDate DateTime? @map("end_date") // 종료일

  issuedAt DateTime @default(now()) @map("issued_at") // 발급일
  usedAt DateTime? @map("used_at") // 사용일
  expiredAt DateTime? @map("expired_at") // 만료 처리일(배치 처리 시)
  cancelledAt DateTime? @map("cancelled_at") // 취소일

  // Snapshot fields (useful for auditing)
  discountAppliedAmount Int? @map("discount_applied_amount") // 실제 적용된 할인 금액(KRW)
  purchaseAmountAtUse Int? @map("purchase_amount_at_use") // 사용 시 구매 금액(KRW)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([issuedAt])
  @@map("coupon_histories")
}

// Banner
enum BannerType {
  MAIN_PRODUCTS      // Main Products (메인 상품)
  CATEGORY          // Category (카테고리)
  FOOTER            // Footer
  CONTENT_HERO      // Content Hero
  SPECIAL_PRICE     // This week's special price (이번주 특가)
}
enum BannerStatus {
  ACTIVE   // 활성화
  INACTIVE // 비활성화
  SCHEDULED // 예약됨
}

enum CategoryType {        
    LIVESTOCK          // 라이브스톡
    CONVENIENCE_FOOD   // 편의점 음식
    FISHERIES          // 수산물
    SIDE_DISH          // 사이드 요리
}

model Banner {
  id String @id @default(uuid())
  productId String? @map("product_id")
  
  category String? @map("category") // 카테고리
  type BannerType @map("type") // 배너 타입
  status BannerStatus @default(ACTIVE) @map("status") // 배너 상태
  
  // Banner content
  title String? @db.VarChar(255) @map("title") // 배너 제목
  badgeText String? @db.VarChar(100) @map("badge_text") // 뱃지 텍스트 (e.g., "asdasad for new members only")
  mainText String? @db.Text @map("main_text") // 메인 텍스트
  ctaButtonText String? @db.VarChar(100) @map("cta_button_text") // CTA 버튼 텍스트 (e.g., "purchase")
  ctaButtonUrl String? @db.VarChar(500) @map("cta_button_url") // CTA 버튼 URL (e.g., "/products/1")
  
  // Image
  imageUrl String @map("image_url") // 배너 이미지 URL (required, min 800x800px)
  mobileImageUrl String? @map("mobile_image_url") // 모바일용 이미지 URL (optional)
  
  // Display settings
  displayOrder Int @default(0) @map("display_order") // 표시 순서 (낮을수록 먼저 표시)
  
  // Scheduling
  startDate DateTime? @map("start_date") // 시작일 (optional for scheduling)
  endDate DateTime? @map("end_date") // 종료일 (optional for scheduling)
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations - Only MAIN_PRODUCTS banners should have product relation
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([type])
  @@index([status])
  @@index([displayOrder])
  @@index([startDate, endDate])
  @@map("banners") 
}

enum PaymentStatus {
  PENDING   // 대기중
  SUCCESS   // 성공
  FAILED    // 실패
  CANCELLED // 취소됨
}

enum PaymentType {
  NORMAL    // 일반결제
  BILLING   // 자동결제 (정기결제)
  BRANDPAY  // 브랜드페이
}


 model Payment {
  id String @id @default(uuid())
  
  // User & Order
  userId String @map("user_id")
  orderGroupNumber String @map("order_group_number") // 가맹점 주문번호
  
  // Toss Payment Keys
  paymentKey String @unique @map("payment_key") // Toss 결제 키 (중요!)
  transactionKey String? @map("transaction_key") // 거래 키
  mId String? @map("m_id") // 가맹점 ID
  
  // Amount Details
  totalAmount Int @map("total_amount") // 총 결제 금액
  balanceAmount Int @map("balance_amount") // 취소 가능 잔액
  suppliedAmount Int? @map("supplied_amount") // 공급가액
  vat Int? @map("vat") // 부가세
  taxFreeAmount Int @default(0) @map("tax_free_amount") // 면세 금액
  taxExemptionAmount Int @default(0) @map("tax_exemption_amount") // 과세 제외 금액
  
  // Payment Info
  status PaymentStatus @default(PENDING) @map("status")
  type PaymentType @default(NORMAL) @map("type")
  method String? @map("method") // 카드, 가상계좌, 계좌이체, 휴대폰 등
  currency String @default("KRW") @map("currency")
  orderName String @map("order_name") // 주문명
  deliveryFee Int @default(0) @map("delivery_fee") // 배송비
  
  // Dates
  requestedAt DateTime @map("requested_at") // 결제 요청 시각
  approvedAt DateTime? @map("approved_at") // 결제 승인 시각
  
  // Failure Info
  failureCode String? @map("failure_code")
  failureMessage String? @map("failure_message")
  
  // Receipt & Details
  receiptUrl String? @map("receipt_url") // 영수증 URL
  
  // Payment Method Details (stored as JSON)
  cardInfo Json? @map("card_info") // 카드 정보
  virtualAccountInfo Json? @map("virtual_account_info") // 가상계좌 정보
  easyPayInfo Json? @map("easy_pay_info") // 간편결제 정보
  transferInfo Json? @map("transfer_info") // 계좌이체 정보
  mobilePhoneInfo Json? @map("mobile_phone_info") // 휴대폰 결제 정보
  giftCertificateInfo Json? @map("gift_certificate_info") // 상품권 정보
  
  // Cancel Info
  cancels Json? @map("cancels") // 취소 내역 (배열)
  canceledAmount Int @default(0) @map("canceled_amount") // 취소된 금액
  
  // Secret & Security
  secret String? @map("secret") // 가상계좌 웹훅 검증용
  
  // Additional
  metadata Json? @map("metadata") // 추가 메타데이터
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderGroup OrderGroup @relation(fields: [orderGroupNumber], references: [orderGroupNumber], onDelete: Cascade)
  @@index([orderGroupNumber])
  @@index([paymentKey])
  @@index([status])
  @@index([requestedAt])
  @@index([userId])
  @@map("payments")
}

