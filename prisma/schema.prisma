generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// User
model User {
  id String @id @unique // ID is unique and also serves as username
  password String? @map("password")
  name String
  membershipLevel String?
  age Int?
  email String
  phoneNumber String @map("phone_number")
  totalUsedPoints Int @default(0) @map("total_used_points")
  availablePoints Int @default(0) @map("available_points")
  registrationDate String @map("registration_date") // Join Date
  dormancyDate String? @map("dormancy_date") // Date account marked inactive
  withdrawalDate String? @map("withdrawal_date")
  withdrawalType String? @map("withdrawal_type")
  reasonForWithdrawal String? @map("reason_for_withdrawal")
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  // Payment Information
  totalPurchaseAmount Int @default(0) @map("total_purchase_amount")
  // Permissions
  dashboardAccess Boolean @default(false) @map("dashboard_access")
  memberAccess Boolean @default(false) @map("member_access")
  productAccess Boolean @default(false) @map("product_access")
  orderAccess Boolean @default(false) @map("order_access")
  recipeAccess Boolean @default(false) @map("recipe_access")
  bannerAccess Boolean @default(false) @map("banner_access")
  
  // Relations
  userRole UserRole[]
  userMembership UserMembership?
  point Point?
  session Session[]
  orders Order[]
  recipes Recipe[]
  couponHistories CouponHistory[]
  @@map("users")
}

model UserMembership {
  id String @id @default(uuid()) @unique
  userId String @unique
  membershipId String
  membershipName String @map("membership_name")
  membershipDescription String @map("membership_description")
  status String @default("normal") @map("status")

  startDate DateTime @map("start_date")
  endDate DateTime @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  // extension
  updatedByAdmin Boolean @default(false) @map("updated_by_admin")

  @@index([membershipId])
  @@index([userId])
  @@index([userId, membershipId])
  @@map("user_memberships")
}

model Membership {
  id String @id @default(uuid())
  name String @unique
  description String?
  minPrice Int @map("min_price")
  userMembership UserMembership[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("memberships")
  @@index([name])
  @@index([minPrice])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  userRole UserRole[]
  // rolePermission RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("roles")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@index([userId])
  @@map("user_roles")
}

