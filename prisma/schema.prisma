model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken     String             @unique
  ip               String?
  expiredAt        DateTime
  refreshTokenUsed RefreshTokenUsed[]

  @@index([userId, expiredAt])
  @@map("sessions")
}

model RefreshTokenUsed {
  id           String  @id @default(uuid())
  refreshToken String  @unique
  sessionId    String
  session      Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_token_used")
}

enum OrderSituation {
  ORDER_NEW // 신규
  ORDER_PAYMENT_PENDING // 결제대기
  ORDER_PAYMENT_COMPLETED // 결제완료
  ORDER_IN_PREPARE // 결제실패
  ORDER_BEING_SHIPPED // 배송중
  ORDER_SHIPPED // 배송완료
  ORDER_CANCELLED // 취소됨
  ORDER_RETURNED // 반품됨
}
// Order
model Order {
  id String @id @default(uuid())
  orderNumber String @default("") @map("order_number") // 1. 주문번호 (Order Number) - text, default
  itemWiseOrderNumber String @default("") @map("item_wise_order_number") // 2. 품목별 주문번호 (Item-wise Order Number) - text, default
  totalOrderAmount Int @map("total_order_amount") // 3. 총 주문금액 (Total Order Amount) - int4
  totalPaymentAmount Int @map("total_payment_amount") // 4. 총 결제금액 (Total Payment Amount) - int4
  productId String @map("product_id") // 5. 상품번호 (Product Number) - int4
  productName String @default("") @map("product_name") // 6. 주문상품명 (Ordered Product Name) - text, default
  productNameWithOptions String @default("") @map("product_name_with_options") // 7. 주문상품명(옵션포) (Ordered Product Name with Options) - text, default
  quantity Int @map("quantity") // 8. 수량 (Quantity) - int4
  recipient String @default("") @map("recipient") // 9. 수령인 (Recipient) - text, default
  recipientAddressFull String @default("") @map("recipient_address_full") // 10. 수령인 주소(전체) (Recipient Address Full) - text, default
  recipientPostalCode Int @map("recipient_postal_code") // 11. 수령인 우편번호 (Recipient Postal Code) - int4
  recipientMobilePhone String @default("") @map("recipient_mobile_phone") // 12. 수령인 휴대전화 (Recipient Mobile Phone) - text, default
  recipientPhoneNumber String @default("") @map("recipient_phone_number") // 13. 수령인 전화번호 (Recipient Phone Number) - text, default
  deliveryMessage String @default("") @map("delivery_message") // 14. 배송메시지 (Delivery Message) - text, default
  salePrice Int @map("sale_price") // 15. 판매가 (Sale Price) - int4
  paymentType String @default("") @map("payment_type") // 16. 결제구분 (Payment Type) - text, default
  paymentMethod String @default("") @map("payment_method") // 17. 결제수단 (Payment Method) - text, default
  orderDate String @default("") @map("order_date") // 18. 발주일 (Order Date) - text, default
  ordererName String @default("") @map("orderer_name") // 19. 주문자명 (Orderer Name) - text, default
  ordererMobilePhone String @default("") @map("orderer_mobile_phone") // 20. 주문자 휴대전화 (Orderer Mobile Phone) - text, default
  ordererId String? @map("orderer_id") // 21. 주문자ID (Orderer ID) - text, default (nullable for relation)
  desiredDeliveryDate String @default("") @map("desired_delivery_date") // 22. 희망배송일 (Desired Delivery Date) - text, default
  membershipLevelAtOrderTime String @default("") @map("membership_level_at_order_time") // 23. 주문 시 회원등급 (Membership Level at Order Time) - text, default
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Extension
  situation OrderSituation? @map("situation") // 상황
  courierCompany String? @map("courier_company") // 택배사
  invoiceNumber String? @map("invoice_number") // 송장번호
  // Relation to User (optional, handles null ordererId)
  user User? @relation(fields: [ordererId], references: [id], onDelete: SetNull)
  couponHistories CouponHistory[]
  // Relation to OrderItems (one order can have many items)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@map("orders")
}

// Point
model Point {
  id String @id @default(uuid())
  date String? @db.VarChar(50) @map("date") // 일자 (Date) - character varying(50)
  userId String? @unique @db.VarChar(50) @map("user_id") // 아이디 (ID) - character varying(50)
  membershipLevel String? @db.VarChar(50) @map("membership_level") // 회원등급 (Membership Level) - character varying(50)
  content String? @db.VarChar(50) @map("content") // 내용 (Content/Details) - character varying(50)
  orderNumber String? @db.VarChar(50) @map("order_number") // 주문번호 (Order Number) - character varying(50)
  pointsType String? @db.VarChar(50) @map("points_type") // 적립금 유형 (Accumulated Points Type) - character varying(50)
  availablePointsIncrease Int? @map("available_points_increase") // 가용적립금 증가 (Available Points Increase) - integer
  availablePointsDeduction Int? @map("available_points_deduction") // 가용적립금 차감 (Available Points Deduction) - integer
  availablePointsBalance Int? @map("available_points_balance") // 가용적립금 잔액 (Available Points Balance) - integer
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relation to User (1-1 relationship) - set to null when user is deleted
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@map("points")
}
// Product
model Product {
  id String @id @default(uuid())
  productCode String? @map("product_code") // 상품코드
  ownProductCode String? @map("own_product_code") // 자체 상품코드
  displayStatus String? @default("ACTIVE") @map("display_status") // 진열상태
  saleStatus String? @map("sale_status") // 판매상태
  productCategoryNumber String? @map("product_category_number") // 상품분류 번호
  productCategoryNewProductArea String? @map("product_category_new_product_area") // 상품분류 신상품영역
  productCategoryRecommendedProductArea String? @map("product_category_recommended_product_area") // 상품분류 추천상품영역
  productName String? @db.VarChar(128) @map("product_name") // 상품명
  englishProductName String? @map("english_product_name") // 영문 상품명
  productNameForManagement String? @map("product_name_for_management") // 상품명(관리용)
  supplierProductName String? @map("supplier_product_name") // 공급사 상품명
  modelName String? @map("model_name") // 모델명
  productSummaryDescription String? @map("product_summary_description") // 상품 요약설명
  productBriefDescription String? @map("product_brief_description") // 상품 간략설명
  searchKeywordSetting String? @map("search_keyword_setting") // 검색어설정
  taxClassification String? @map("tax_classification") // 과세구분
  consumerPrice Int? @map("consumer_price") // 소비자가
  supplyPrice Int? @map("supply_price") // 공급가
  productPrice Int? @map("product_price") // 상품가
  salePrice Int? @map("sale_price") // 판매가
  useSalePriceAlternativeText String? @map("use_sale_price_alternative_text") // 판매가 대체문구 사용
  salePriceAlternativeText String? @map("sale_price_alternative_text") // 판매가 대체문구
  orderQuantityLimitCriteria String? @map("order_quantity_limit_criteria") // 주문수량 제한 기준
  minOrderQuantity Int? @map("min_order_quantity") // 최소 주문수량(이상)
  maxOrderQuantity Int? @map("max_order_quantity") // 최대 주문수량(이하)
  rewardPoints Int? @map("reward_points") // 적립금
  rewardPointsClassification String? @map("reward_points_classification") // 적립금 구분
  commonEventInfo String? @map("common_event_info") // 공통이벤트 정보
  adultVerification String? @map("adult_verification") // 성인인증
  optionUsage String? @map("option_usage") // 옵션사용
  itemCompositionMethod String? @map("item_composition_method") // 품목 구성방식
  optionDisplayMethod String? @map("option_display_method") // 옵션 표시방식
  optionSetName String? @map("option_set_name") // 옵션세트명
  optionInput String? @map("option_input") // 옵션입력
  optionStyle String? @map("option_style") // 옵션 스타일
  buttonImageSetting String? @map("button_image_setting") // 버튼이미지 설정
  colorSetting String? @map("color_setting") // 색상 설정
  requiredOrNot String? @map("required_or_not") // 필수여부
  outOfStockDisplayText String? @map("out_of_stock_display_text") // 품절표시 문구
  additionalInputOption String? @map("additional_input_option") // 추가입력옵션
  additionalInputOptionName String? @map("additional_input_option_name") // 추가입력옵션 명칭
  additionalInputOptionRequiredOrNot String? @map("additional_input_option_required_or_not") // 추가입력옵션 선택/필수여부
  inputCharacterCount String? @map("input_character_count") // 입력글자수(자)
  imageRegistrationDetail String? @map("image_registration_detail") // 이미지등록(상세)
  imageRegistrationList String? @map("image_registration_list") // 이미지등록(목록)
  imageRegistrationSmallList String? @map("image_registration_small_list") // 이미지등록(작은목록)
  imageRegistrationThumbnail String? @map("image_registration_thumbnail") // 이미지등록(축소)
  manufacturer String? @map("manufacturer") // 제조사
  supplier String? @map("supplier") // 공급사
  brand String? @map("brand") // 브랜드
  trend String? @map("trend") // 트렌드
  ownClassificationCode String? @map("own_classification_code") // 자체분류 코드
  manufacturingDate String? @map("manufacturing_date") // 제조일자
  releaseDate String? @map("release_date") // 출시일자
  validityPeriodUsage String? @map("validity_period_usage") // 유효기간 사용여부
  validityPeriod String? @map("validity_period") // 유효기간
  origin Int? @map("origin") // 원산지
  productVolume String? @map("product_volume") // 상품부피(cm)
  volumeWeight String? @map("volume_weight") // 부피무게(kg)
  productPaymentGuide String? @map("product_payment_guide") // 상품결제안내
  productDeliveryGuide String? @map("product_delivery_guide") // 상품배송안내
  exchangeReturnGuide String? @map("exchange_return_guide") // 교환/반품안내
  serviceInquiryGuide String? @map("service_inquiry_guide") // 서비스문의/안내
  deliveryInfo String? @map("delivery_info") // 배송정보
  deliveryMethod String? @map("delivery_method") // 배송방법
  domesticOverseasDelivery String? @map("domestic_overseas_delivery") // 국내/해외배송
  deliveryArea String? @map("delivery_area") // 배송지역
  deliveryFeePrepaymentSetting String? @map("delivery_fee_prepayment_setting") // 배송비 선결제 설정
  deliveryPeriod String? @map("delivery_period") // 배송기간
  deliveryFeeClassification String? @map("delivery_fee_classification") // 배송비 구분
  deliveryFeeInput String? @map("delivery_fee_input") // 배송비입력
  productClassificationCustoms String? @map("product_classification_customs") // 상품 구분(해외통관)
  productMaterial String? @map("product_material") // 상품소재
  englishProductMaterialCustoms String? @map("english_product_material_customs") // 영문 상품소재(해외통관)
  fabricCustoms String? @map("fabric_customs") // 옷감(해외통관)
  seoSearchEngineExposureSetting String? @map("seo_search_engine_exposure_setting") // 검색엔진최적화(SEO) 검색엔진 노출 설정
  seoTitle String? @map("seo_title") // 검색엔진최적화(SEO) Title
  seoAuthor String? @map("seo_author") // 검색엔진최적화(SEO) Author
  seoDescription String? @map("seo_description") // 검색엔진최적화(SEO) Description
  seoKeywords String? @map("seo_keywords") // 검색엔진최적화(SEO) Keywords
  seoProductImageAltText String? @map("seo_product_image_alt_text") // 검색엔진최적화(SEO) 상품 이미지 Alt 텍스트
  individualPaymentMethodSetting String? @map("individual_payment_method_setting") // 개별결제수단설정
  productDeliveryTypeCode String? @map("product_delivery_type_code") // 상품배송유형 코드
  storePickupSetting String? @map("store_pickup_setting") // 스토어픽업 설정
  productTotalWeight Int? @map("product_total_weight") // 상품 전체중량(kg)
  hsCode BigInt? @map("hs_code") // HS코드
  additionalItem01TodayDepartureDeliveryUsage String? @map("additional_item_01_today_departure_delivery_usage") // 추가항목01_오늘출발 배송 사용설정
  additionalItem02TodayDepartureDeliveryTime String? @map("additional_item_02_today_departure_delivery_time") // 추가항목02_오늘출발 배송 시간설정
  additionalItem03StorageMethod String? @map("additional_item_03_storage_method") // 추가항목03_보관방식
  additionalItem04Origin String? @map("additional_item_04_origin") // 추가항목04_원산지
  additionalItem05Event String? @map("additional_item_05_event") // 추가항목05_이벤트
  additionalItem06ParcelDelivery String? @map("additional_item_06_parcel_delivery") // 추가항목06_택배배송
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // extension
  ctaButtonUrl String? @db.VarChar(500) @map("cta_button_url")
  // relation 
  order Order[]
  productCategory Category? @relation(fields: [productCategoryNumber], references: [productCategoryNumber], onDelete: SetNull)
  banner Banner[]
  // productRecipes ProductRecipe[]
  productSpecialOffer ProductSpecialOffer?
  productDiscount ProductDiscount?
  @@map("products")
}

model ProductDiscount{
  id String @id @default(uuid())
  status Boolean @default(false) @map("status")
  productId String @map("product_id") @unique 

  discountRate Int @map("discount_rate")

  discountStartDate DateTime? @map("discount_start_date")
  discountEndDate DateTime? @map("discount_end_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relation
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@map("product_discounts")
}
model ProductSpecialOffer {
  id String @id @default(uuid())
  status Boolean @default(false) @map("status")
  productId String @map("product_id") @unique 

  discountAmount Int @map("discount_amount")
  specialPriceApplied Int? @map("special_price_applied")

  startDate DateTime? @map("start_date")
  endDate DateTime? @map("end_date")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  // relation
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@map("product_special_offers")
}

